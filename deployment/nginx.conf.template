load_module /usr/lib/nginx/modules/ngx_stream_module.so;
worker_processes 1;
pid /tmp/nginx.pid;
error_log stderr warn;
events { worker_connections 128; }
stream {
    server {
        listen 0.0.0.0:${SERVER_PORT};
        listen [::]:${SERVER_PORT};
        proxy_pass 127.0.0.1:${HOST_LOOPBACK_PORT};
        proxy_connect_timeout 10s;
        proxy_timeout 1h;
    }
}
